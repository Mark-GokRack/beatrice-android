<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vst_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Section: Gain -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_gain"
            android:textColor="@color/vst_accent"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <!-- InputGain row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/input_gain"
                android:textColor="@color/vst_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/input_gain_value"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="@color/vst_text_primary"
                android:textSize="13sp"
                android:gravity="end"
                android:text="0.0 dB" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/input_gain_decrement"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/input_gain_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-60.0"
                android:valueTo="20.0"
                android:stepSize="0.1"
                android:value="0.0"
                app:trackColorActive="@color/vst_accent"
                app:trackColorInactive="@color/vst_slider_inactive"
                app:thumbColor="@color/vst_accent" />

            <Button
                android:id="@+id/input_gain_increment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- OutputGain row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/output_gain"
                android:textColor="@color/vst_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/output_gain_value"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:textColor="@color/vst_text_primary"
                android:textSize="13sp"
                android:gravity="end"
                android:text="0.0 dB" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/output_gain_decrement"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/output_gain_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-60.0"
                android:valueTo="20.0"
                android:stepSize="0.1"
                android:value="0.0"
                app:trackColorActive="@color/vst_accent"
                app:trackColorInactive="@color/vst_slider_inactive"
                app:thumbColor="@color/vst_accent" />

            <Button
                android:id="@+id/output_gain_increment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/vst_divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Section: Pitch / Formant -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_pitch_formant"
            android:textColor="@color/vst_accent"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <!-- PitchShift row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pitch_shift"
                android:textColor="@color/vst_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pitch_shift_value"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:textColor="@color/vst_text_primary"
                android:textSize="13sp"
                android:gravity="end"
                android:text="0.00" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/pitch_shift_decrement"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/pitch_shift_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-24.0"
                android:valueTo="24.0"
                android:stepSize="0.125"
                android:value="0.0"
                app:trackColorActive="@color/vst_accent"
                app:trackColorInactive="@color/vst_slider_inactive"
                app:thumbColor="@color/vst_accent" />

            <Button
                android:id="@+id/pitch_shift_increment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

        </LinearLayout>

        <!-- FormantShift row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/formant_shift"
                android:textColor="@color/vst_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/formant_shift_value"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:textColor="@color/vst_text_primary"
                android:textSize="13sp"
                android:gravity="end"
                android:text="0.0" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/formant_shift_decrement"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/formant_shift_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="-2.0"
                android:valueTo="2.0"
                android:stepSize="0.5"
                android:value="0.0"
                app:trackColorActive="@color/vst_accent"
                app:trackColorInactive="@color/vst_slider_inactive"
                app:thumbColor="@color/vst_accent" />

            <Button
                android:id="@+id/formant_shift_increment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/vst_divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Section: Quality -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_quality"
            android:textColor="@color/vst_accent"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <!-- VQ Neighbors row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vq_neighbors"
                android:textColor="@color/vst_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/vq_neighbors_value"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:textColor="@color/vst_text_primary"
                android:textSize="13sp"
                android:gravity="end"
                android:text="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/vq_neighbors_decrement"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="−"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/vq_neighbors_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0.0"
                android:valueTo="8.0"
                android:stepSize="1.0"
                android:value="1.0"
                app:trackColorActive="@color/vst_accent"
                app:trackColorInactive="@color/vst_slider_inactive"
                app:thumbColor="@color/vst_accent" />

            <Button
                android:id="@+id/vq_neighbors_increment"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="@color/vst_accent"
                android:textSize="18sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/vst_divider"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

        <!-- Expandable Advanced section header -->
        <LinearLayout
            android:id="@+id/advanced_section_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_advanced_pitch"
                android:textColor="@color/vst_accent"
                android:textSize="11sp"
                android:textAllCaps="true"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/advanced_section_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x25BC;"
                android:textColor="@color/vst_accent"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Advanced section content (initially hidden) -->
        <LinearLayout
            android:id="@+id/advanced_section_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- IntonationIntensity row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/intonation_intensity"
                    android:textColor="@color/vst_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/intonation_intensity_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="13sp"
                    android:gravity="end"
                    android:text="1.00" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/intonation_intensity_decrement"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&#x2212;"
                    android:textColor="@color/vst_accent"
                    android:textSize="18sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/intonation_intensity_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="-1.0"
                    android:valueTo="3.0"
                    android:stepSize="0.1"
                    android:value="1.0"
                    app:trackColorActive="@color/vst_accent"
                    app:trackColorInactive="@color/vst_slider_inactive"
                    app:thumbColor="@color/vst_accent" />

                <Button
                    android:id="@+id/intonation_intensity_increment"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/vst_accent"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- PitchCorrection row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pitch_correction"
                    android:textColor="@color/vst_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pitch_correction_value"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="13sp"
                    android:gravity="end"
                    android:text="0.00" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/pitch_correction_decrement"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="&#x2212;"
                    android:textColor="@color/vst_accent"
                    android:textSize="18sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/pitch_correction_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:stepSize="0.05"
                    android:value="0.0"
                    app:trackColorActive="@color/vst_accent"
                    app:trackColorInactive="@color/vst_slider_inactive"
                    app:thumbColor="@color/vst_accent" />

                <Button
                    android:id="@+id/pitch_correction_increment"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="+"
                    android:textColor="@color/vst_accent"
                    android:textSize="18sp" />

            </LinearLayout>

            <!-- PitchCorrectionMode -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pitch_correction_mode"
                android:textColor="@color/vst_text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/pitch_correction_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/pcm_hard0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pcm_hard0"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="13sp"
                    android:checked="true"
                    android:layout_marginEnd="8dp" />

                <RadioButton
                    android:id="@+id/pcm_hard1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pcm_hard1"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="13sp"
                    android:layout_marginEnd="8dp" />

            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/vst_divider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp" />

            <!-- SourcePitchRange -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_pitch_range"
                    android:textColor="@color/vst_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/source_pitch_range_value"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="13sp"
                    android:gravity="end"
                    android:text="33.125 - 80.875" />

            </LinearLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/source_pitch_range_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="20.0"
                android:valueTo="100.0"
                android:stepSize="0.125"
                app:values="@array/source_pitch_range_defaults"
                app:trackColorActive="@color/vst_accent"
                app:trackColorInactive="@color/vst_slider_inactive"
                app:thumbColor="@color/vst_accent" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
