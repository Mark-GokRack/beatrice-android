<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vst_bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pre-FX section header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_pre_fx"
            android:textColor="@color/vst_accent"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <!-- Amplifier -->
        <include
            android:id="@+id/amplifier_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/amplifier_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/vst_bg_secondary">

            <include
                android:id="@+id/amplifier_gain_slider"
                layout="@layout/item_effector_slider" />
        </LinearLayout>

        <!-- RNNoise -->
        <include
            android:id="@+id/rnnoise_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/rnnoise_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/vst_bg_secondary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rnnoise_ready"
                    android:textColor="@color/vst_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rnnoise_ready_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rnnoise_ready_no"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rnnoise_vad"
                    android:textColor="@color/vst_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/rnnoise_vad_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="@color/vst_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/rnnoise_vad_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/vst_accent"
                android:progressBackgroundTint="@color/vst_bg_card" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/peak"
                android:textColor="@color/vst_text_secondary"
                android:textSize="12sp" />

            <com.gokrack.beatriceapp.view.PeakMeterView
                android:id="@+id/rnnoise_input_peak_meter"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="2dp" />

            <com.gokrack.beatriceapp.view.PeakMeterView
                android:id="@+id/rnnoise_output_peak_meter"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="0dp" />

            <com.gokrack.beatriceapp.view.PeakMeterView
                android:id="@+id/rnnoise_tick_meter"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="0dp" />
        </LinearLayout>

        <!-- Noise Gate -->
        <include
            android:id="@+id/noise_gate_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/noise_gate_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/vst_bg_secondary">

            <include
                android:id="@+id/noise_gate_meters"
                layout="@layout/item_effector_dynamic_meters" />

            <include
                android:id="@+id/noise_gate_threshold_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/noise_gate_range_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/noise_gate_attack_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/noise_gate_release_slider"
                layout="@layout/item_effector_slider" />
        </LinearLayout>

        <!-- Compressor -->
        <include
            android:id="@+id/compressor_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/compressor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/vst_bg_secondary">

            <include
                android:id="@+id/compressor_meters"
                layout="@layout/item_effector_dynamic_meters" />

            <include
                android:id="@+id/compressor_threshold_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/compressor_ratio_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/compressor_attack_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/compressor_release_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/compressor_makeup_gain_slider"
                layout="@layout/item_effector_slider" />
        </LinearLayout>

        <!-- Pre-Equalizer -->
        <include
            android:id="@+id/pre_equalizer_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/pre_equalizer_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/vst_bg_secondary">

            <com.gokrack.beatriceapp.view.EqCurveView
                android:id="@+id/pre_equalizer_curve"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp"
                android:background="@color/vst_bg_card" />

            <include
                android:id="@+id/pre_eq_band_0"
                layout="@layout/item_eq_band" />

            <include
                android:id="@+id/pre_eq_band_1"
                layout="@layout/item_eq_band" />

            <include
                android:id="@+id/pre_eq_band_2"
                layout="@layout/item_eq_band" />
        </LinearLayout>

        <!-- Post-FX section header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_post_fx"
            android:textColor="@color/vst_accent"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <!-- Post-Equalizer -->
        <include
            android:id="@+id/post_equalizer_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/post_equalizer_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:background="@color/vst_bg_secondary">

            <com.gokrack.beatriceapp.view.EqCurveView
                android:id="@+id/post_equalizer_curve"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginBottom="12dp"
                android:background="@color/vst_bg_card" />

            <include
                android:id="@+id/post_eq_band_0"
                layout="@layout/item_eq_band" />

            <include
                android:id="@+id/post_eq_band_1"
                layout="@layout/item_eq_band" />

            <include
                android:id="@+id/post_eq_band_2"
                layout="@layout/item_eq_band" />

            <include
                android:id="@+id/post_eq_band_3"
                layout="@layout/item_eq_band" />

            <include
                android:id="@+id/post_eq_band_4"
                layout="@layout/item_eq_band" />
        </LinearLayout>

        <!-- Limiter -->
        <include
            android:id="@+id/limiter_section_header"
            layout="@layout/item_effector_section" />

        <LinearLayout
            android:id="@+id/limiter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp"
            android:layout_marginBottom="48dp"
            android:background="@color/vst_bg_secondary">

            <include
                android:id="@+id/limiter_meters"
                layout="@layout/item_effector_dynamic_meters" />

            <include
                android:id="@+id/limiter_threshold_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/limiter_attack_slider"
                layout="@layout/item_effector_slider" />

            <include
                android:id="@+id/limiter_release_slider"
                layout="@layout/item_effector_slider" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
