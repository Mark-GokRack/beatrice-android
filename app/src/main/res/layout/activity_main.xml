<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vst_bg_primary">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/vst_bg_secondary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp"/>

    <!-- Tab layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vst_bg_secondary"
        app:tabTextColor="@color/vst_text_secondary"
        app:tabSelectedTextColor="@color/vst_text_primary"
        app:tabIndicatorColor="@color/vst_accent_purple"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- Swipeable fragment container -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/vst_bg_primary" />

    <!-- Bottom bar  Ealways visible -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/vst_bg_secondary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/status_view_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_warning"
            android:textColor="@color/vst_text_secondary"
            android:textSize="11sp"
            android:maxLines="2"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/button_toggle_effect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/start_effect"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/vst_accent_purple"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>

