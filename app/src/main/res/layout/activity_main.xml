<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activity_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vst_bg_primary">

    <!-- Preset bar -->
    <LinearLayout
        android:id="@+id/preset_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/vst_bg_secondary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <Spinner
            android:id="@+id/preset_spinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <ImageButton
            android:id="@+id/preset_save_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/preset_save"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_save" />

        <ImageButton
            android:id="@+id/preset_reset_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerInside"
            android:contentDescription="@string/preset_reset"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate" />

    </LinearLayout>

    <!-- Tab layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vst_bg_secondary"
        app:tabTextColor="@color/vst_text_secondary"
        app:tabSelectedTextColor="@color/vst_text_primary"
        app:tabIndicatorColor="@color/vst_accent"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabGravity="center" />

    <!-- Swipeable fragment container -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/vst_bg_primary" />

</LinearLayout>